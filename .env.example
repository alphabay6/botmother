# BotMother — Environment Configuration Example
# Copy this file to .env and fill in your values

# ==============================
# TELEGRAM BOT
# ==============================
BOT_TOKEN=your_bot_token_here
OWNER_ID=123456789
ADMIN_ID=123456789
YOUR_USERNAME=@yourusername
UPDATE_CHANNEL=https://t.me/yourchannel

# ==============================
# FORCE JOIN CHANNELS
# Comma-separated channel/group usernames or IDs
# Examples: @mychannel,@mygroup,-100123456789
# Leave empty to disable force join
# ==============================
FORCE_JOIN_CHANNELS=@yourchannel,@yourgroup

# ==============================
# WEB ADMIN PANEL
# ==============================
WEB_ADMIN_PASSWORD=your_strong_password_here
WEB_SESSION_SECRET=change_this_to_a_random_string_in_production

# ==============================
# FREE TRIAL
# ==============================
FREE_TRIAL_DAYS=18
FREE_TRIAL_LIMIT=1

# ==============================
# REFERRAL SYSTEM
# ==============================
REFERRALS_PER_REWARD=5
REFERRAL_REWARD_SLOTS=1

# ==============================
# USER LIMITS
# ==============================
FREE_USER_LIMIT=0
FREE_TRIAL_LIMIT=1
SUBSCRIBED_USER_LIMIT=15
ADMIN_LIMIT=999

# ==============================
# TRIAL RESOURCE LIMITS
# ==============================
TRIAL_MAX_MEMORY_MB=50
TRIAL_MAX_CPU_PERCENT=5.0

# ==============================
# FLASK SERVER
# On Waifly: set this to the port shown in your server panel
# OR Waifly sets PORT automatically — check your server's port setting
# Your subdomain bot.waifly.com maps to port 25584, so set:
# FLASK_PORT=25584
# ==============================
FLASK_PORT=25584

# ==============================
# MONITORING
# ==============================
WATCHDOG_INTERVAL=30
MAX_RESTART_ATTEMPTS=5
MEMORY_ALERT_THRESHOLD=80
